# Copy to .env.production on the deployment host. Never commit the real file.
COMPOSE_PROJECT_NAME=fixledger-prod
APP_DOMAIN=fixledger.example.com
APP_VERSION=0.1.0

# Use immutable release tags or image digests in the real environment file.
BACKEND_IMAGE=registry.example.com/fixledger/backend:0.1.0
FRONTEND_IMAGE=registry.example.com/fixledger/frontend:0.1.0
MYSQL_IMAGE=mysql:8.4.10
REDIS_IMAGE=redis:7.4.9-alpine
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.11
GATEWAY_IMAGE=nginx:1.30.4-alpine
BACKUP_TOOLS_IMAGE=alpine:3.21.7

HTTP_PORT=80
HTTPS_PORT=443
TLS_CERTIFICATE_DIR=./deploy/certs
BACKUP_DIR=./backups

MYSQL_DATABASE=fixledger
MYSQL_USERNAME=fixledger
MYSQL_PASSWORD=replace-with-a-strong-production-secret
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-secret

REDIS_PASSWORD=replace-with-a-strong-production-secret
REDIS_DATABASE=0

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL_SECONDS=86400

FILE_STORAGE_TYPE=rustfs
FILE_S3_ENDPOINT=http://rustfs:9000
FILE_S3_ACCESS_KEY=replace-with-a-production-access-key
FILE_S3_SECRET_KEY=replace-with-a-strong-production-secret
FILE_S3_BUCKET=fixledger-files
FILE_S3_REGION=us-east-1
FILE_S3_PATH_STYLE_ACCESS=true
FILE_S3_CREATE_BUCKET=true
FILE_MAX_SIZE=20MB
FILE_MAX_REQUEST_SIZE=25MB

AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

REMINDER_SCAN_CRON=0 0 8 * * *
DASHBOARD_SUMMARY_CACHE_ENABLED=true
DASHBOARD_SUMMARY_CACHE_TTL=2m
EXPORT_MAX_SYNC_ROWS=5000

NOTIFICATION_DISPATCH_CRON=0 */1 * * * *
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5m
NOTIFICATION_MAX_RETRY_DELAY=6h
NOTIFICATION_CONNECT_TIMEOUT=5s
NOTIFICATION_REQUEST_TIMEOUT=10s
NOTIFICATION_PROCESSING_TIMEOUT=15m

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true

NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_ENDPOINT=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_ALLOW_INSECURE_HTTP=false
