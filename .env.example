# FixLedger local development example. Copy to .env and adjust locally.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fixledger
MYSQL_USERNAME=fixledger
MYSQL_PASSWORD=fixledger_dev_password
MYSQL_ROOT_PASSWORD=root_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

JWT_SECRET=replace-with-at-least-32-byte-development-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=86400

# File storage: local for local tests, rustfs for Docker demo.
FILE_STORAGE_TYPE=rustfs
FILE_STORAGE_ROOT=./uploads
FILE_MAX_SIZE=20MB
FILE_MAX_REQUEST_SIZE=25MB
FILE_S3_ENDPOINT=http://rustfs:9000
FILE_S3_ACCESS_KEY=fixledger
FILE_S3_SECRET_KEY=fixledger123
FILE_S3_BUCKET=fixledger-files
FILE_S3_REGION=us-east-1
FILE_S3_PATH_STYLE_ACCESS=true
FILE_S3_CREATE_BUCKET=true

# RustFS container image and ports. FILE_S3_ACCESS_KEY/SECRET_KEY are reused as the RustFS account.
RUSTFS_IMAGE=rustfs/rustfs:latest
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Docker demo uses SQL_INIT_MODE=always to initialize schema and sample data.
SQL_INIT_MODE=always
SQL_DATA_LOCATIONS=classpath:db/demo-data.sql

AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

REMINDER_SCAN_CRON=0 0 8 * * *

# Performance and observability. Metrics endpoints stay closed unless explicitly added here.
DASHBOARD_SUMMARY_CACHE_ENABLED=true
DASHBOARD_SUMMARY_CACHE_TTL=2m
EXPORT_MAX_SYNC_ROWS=5000
MANAGEMENT_ENDPOINTS=health,info

# External notification delivery is opt-in. Do not commit real credentials or secrets.
NOTIFICATION_DISPATCH_CRON=0 */1 * * * *
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5m
NOTIFICATION_MAX_RETRY_DELAY=6h
NOTIFICATION_CONNECT_TIMEOUT=5s
NOTIFICATION_REQUEST_TIMEOUT=10s
NOTIFICATION_PROCESSING_TIMEOUT=15m

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false

NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_ENDPOINT=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_ALLOW_INSECURE_HTTP=false

# Optional: override when Docker Hub is unavailable and a registry mirror is configured.
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
JRE_IMAGE=eclipse-temurin:21-jre
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
